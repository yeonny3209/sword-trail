{
  "name": "sword-trail-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "wrangler dev --port 8787 --local",
    "db:migrate": "wrangler d1 migrations apply sword-trail-online --local",
    "db:migrate:remote": "wrangler d1 migrations apply sword-trail-online --remote",
    "check": "tsc --noEmit -p . && tsc --noEmit -p server",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "cloud:setup": "node scripts/cloud-setup.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.151.1"
  }
}
